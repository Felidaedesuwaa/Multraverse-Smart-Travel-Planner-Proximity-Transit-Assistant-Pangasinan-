MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/multraverse?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-secret"
# One-time superadmin bootstrap: choose your own credentials, then run npm run seed:superadmin.
# Remove these two variables after the account is created. Never commit real credentials.
SUPERADMIN_SEED_EMAIL=
SUPERADMIN_SEED_PASSWORD=
# Required for signup verification. For Gmail use an app password, not your login password.
# SMTP_PORT=587 uses STARTTLS; 465 uses TLS from connection start.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# For Gmail, use the same address as SMTP_USER (or a verified Send mail as alias).
MAIL_FROM="Multraverse <your-sender@gmail.com>"
AI_SERVICE_URL="http://localhost:8000"
PORT=3001
CORS_ORIGINS="http://localhost:8081"
# Optional Photon search endpoint; no key needed for the public demo.
# For higher traffic, point this at your own Photon instance.
PHOTON_URL="https://photon.komoot.io/api/"
# Required for authenticator enrollment. Generate 32 random bytes as 64 hex
# characters; keep this separate from JWT_SECRET and preserve it across deploys.
MFA_ENCRYPTION_KEY=
# Same random secret in ai-service/.env; never expose it as EXPO_PUBLIC_*.
AI_SERVICE_TOKEN=

# Optional comma-separated ORIGINAL keys retained during MFA encryption key rotation.
# Restore the original key here if existing authenticators cannot be decrypted.
MFA_PREVIOUS_ENCRYPTION_KEYS=
