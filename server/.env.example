MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/multraverse?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-secret"
# Required for signup verification. For Gmail use an app password, not your login password.
# SMTP_PORT=587 uses STARTTLS; 465 uses TLS from connection start.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Multraverse <your-sender@gmail.com>"
AI_SERVICE_URL="http://localhost:8000"
PORT=3001
CORS_ORIGINS="http://localhost:8081"
# Optional Photon search endpoint; no key needed for the public demo.
# For higher traffic, point this at your own Photon instance.
PHOTON_URL="https://photon.komoot.io/api/"
