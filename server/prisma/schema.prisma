generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(EXPLORER)
  location     String?       @default("Dagupan City")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trips         Trip[]
  savedPlaces   SavedPlace[]
  budgetEntries BudgetEntry[]
}

enum Role {
  EXPLORER
  PRO
  ADMIN
}

model Trip {
  id        String     @id @default(cuid())
  userId    String
  title     String
  location  String
  date      String
  status    TripStatus @default(UPCOMING)
  budget    Float      @default(0)
  spent     Float      @default(0)
  stops     Int        @default(0)
  icon      String     @default("landmark")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripStops     TripStop[]
  budgetEntries BudgetEntry[]
}

enum TripStatus {
  UPCOMING
  COMPLETED
}

model TripStop {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  address   String?
  order     Int
  createdAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model SavedPlace {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String
  description String?
  icon        String   @default("landmark")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BudgetEntry {
  id        String   @id @default(cuid())
  userId    String
  tripId    String?
  label     String
  amount    Float
  color     String   @default("#0B3C5D")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
}

model TransitRoute {
  id         String      @id @default(cuid())
  name       String
  type       RouteType
  stops      Int         @default(0)
  frequency  String
  passengers Int         @default(0)
  status     RouteStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum RouteType {
  BUS
  JEEPNEY
  TRICYCLE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

model Geofence {
  id        String   @id @default(cuid())
  location  String
  zone      String
  radius    String
  coord     String?
  x         Float    @default(50)
  y         Float    @default(50)
  active    Boolean  @default(true)
  alerts    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Place {
  id           String   @id @default(cuid())
  name         String
  description  String
  location     String
  municipality String
  category     String
  entryFee     Float    @default(0)
  openHours    String?
  tips         String?
  highlights   String?
  createdAt    DateTime @default(now())
}

model RoutePrice {
  id        String   @id @default(cuid())
  from      String
  to        String
  vehicle   String
  price     Float
  duration  String
  notes     String?
  createdAt DateTime @default(now())
}

model LocalFood {
  id          String   @id @default(cuid())
  name        String
  description String
  avgPrice    Float
  where       String
  category    String
  createdAt   DateTime @default(now())
}

model Phrasebook {
  id          String @id @default(cuid())
  filipino    String
  pangasinan  String
  english     String
  category    String
  createdAt   DateTime @default(now())
}