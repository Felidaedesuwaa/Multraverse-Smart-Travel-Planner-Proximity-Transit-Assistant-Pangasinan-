{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,json,env --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node seeds/seed.ts",
    "seed:kb": "ts-node seeds/seedKnowledge.ts",
    "seed:phrases": "ts-node seeds/seedPhrasebook.ts",
    "seed:planner": "ts-node seeds/seedPlanner.ts",
    "test:planner": "npm run build && node scripts/check-planner.cjs && node scripts/check-planner-api.cjs",
    "test:registration": "npm run build && node scripts/check-registration.cjs",
    "test:auth": "npm run build && node scripts/check-registration-api.cjs --isolated-database",
    "check:email": "npm run build && node scripts/check-email.cjs",
    "test:environment": "npm run build && node scripts/check-environment.cjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed:lgu": "ts-node seeds/seedLGU.ts",
    "migrate:lgu": "npm run build && node scripts/migrate-lgu.cjs",
    "test:lgu": "npm run build && node scripts/check-lgu-api.cjs --isolated-database",
    "seed:superadmin": "ts-node seeds/seedSuperAdmin.ts",
    "test:superadmin": "npm run build && node scripts/check-superadmin-api.cjs --isolated-database"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/mongoose": "^5.11.96",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
