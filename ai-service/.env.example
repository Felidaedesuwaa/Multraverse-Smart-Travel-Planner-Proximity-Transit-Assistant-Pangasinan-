# Reserved for the training and serving phases. No Groq key is needed here.
MODEL_DIR=./model
HF_HOME=./.cache/huggingface
# MongoDB uses server/.env (or an explicitly exported MONGODB_URI).
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
# Match server/.env. Minimum 32 characters; generate a random 64-character hex key.
AI_SERVICE_TOKEN=
