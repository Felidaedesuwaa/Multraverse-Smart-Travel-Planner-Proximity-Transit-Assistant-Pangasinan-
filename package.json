{
  "name": "multraverse",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:emulator": "expo start --android --localhost",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "build": "expo export --platform all",
    "build:web": "expo export --platform web",
    "lint": "eslint .",
    "test:transit": "node scripts/check-transit-map.cjs && node scripts/check-transit-page.cjs && node scripts/check-transit-alarm.cjs && npm run build --prefix server && node server/scripts/check-transit-search.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
