{
  "name": "multraverse",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:emulator": "expo start --android --localhost",
    "ios": "expo start --ios",
    "ios:web": "node scripts/start-iphone-web.cjs",
    "android:web": "node scripts/start-mobile-preview.cjs --web-only",
    "preview": "node scripts/start-mobile-preview.cjs",
    "preview:web": "node scripts/start-mobile-preview.cjs --web-only",
    "preview:android": "node scripts/start-mobile-preview.cjs --android",
    "preview:ios": "node scripts/start-mobile-preview.cjs --ios",
    "build:preview:android": "npx eas-cli@latest build --platform android --profile android-device",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile ios-device",
    "build:preview:ios-simulator": "npx eas-cli@latest build --platform ios --profile ios-simulator",
    "web": "expo start --web",
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "build": "expo export --platform all",
    "build:web": "expo export --platform web",
    "lint": "eslint .",
    "test:startup": "node scripts/check-mobile-startup.cjs",
    "test:itinerary": "node scripts/check-itinerary-render.cjs",
    "test:trips": "node scripts/check-my-trips-render.cjs",
    "test:notifications": "node scripts/check-notifications-recovery.cjs",
    "test:transit": "node scripts/check-transit-map.cjs && node scripts/check-transit-page.cjs && node scripts/check-transit-alarm.cjs && node scripts/check-transit-alerts.cjs && node scripts/check-transit-permission.cjs && npm run build --prefix server && node server/scripts/check-transit-search.cjs",
    "test:saved-places": "node scripts/check-saved-places-render.cjs",
    "test:maps": "node scripts/check-transit-map.cjs && node scripts/check-google-map.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-task-manager": "~57.0.21",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^10.8.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/metro-config": {
      "postcss": "^8.5.28"
    }
  }
}
