# Optional: set this for a deployed API or to explicitly target a LAN host.
# On Expo Go, the app automatically uses Metro's LAN host when this is omitted.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# Required for registration CAPTCHA on web, Android and iOS (public site key).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Native apps load the challenge page from this deployed website origin.
EXPO_PUBLIC_SITE_URL=https://multraverse-smart-travel-planner-pr.vercel.app

# Google Maps for the web Transit Alarm pin picker. Enable Maps JavaScript API
# and restrict this browser key to your app's HTTP referrers in Google Cloud.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_maps_key

# Optional: comma-separated non-local origins permitted by the Express server.
# Set this in server/.env when hosting the web app outside localhost.
# CORS_ORIGINS=https://your-web-app.example.com
